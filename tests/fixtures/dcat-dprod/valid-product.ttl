@prefix dprod: <https://www.omg.org/spec/DPROD/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://fixtures.example.test/products/air-quality> a dprod:DataProduct ;
  rdfs:label "Air quality product" ;
  dct:description "Verified air-quality observations." ;
  dprod:purpose "Support environmental decisions." ;
  dprod:dataProductOwner <https://fixtures.example.test/agents/environment> ;
  dprod:domain <https://fixtures.example.test/domains/environment> ;
  dprod:lifecycleStatus <https://fixtures.example.test/lifecycle/deploy> ;
  dprod:inputPort <https://fixtures.example.test/services/input> ;
  dprod:outputPort <https://fixtures.example.test/services/output> ;
  dprod:inputDataset <https://fixtures.example.test/datasets/raw-air> ;
  dprod:outputDataset <https://fixtures.example.test/datasets/air-quality> ;
  odrl:hasPolicy <https://fixtures.example.test/policies/air-quality> .

<https://fixtures.example.test/agents/environment> a prov:Agent ;
  rdfs:label "Environment Office" .
<https://fixtures.example.test/lifecycle/deploy> a dprod:DataProductLifecycleStatus .
<https://fixtures.example.test/policies/air-quality> a odrl:Policy .
<https://fixtures.example.test/datasets/raw-air> a dcat:Dataset ;
  rdfs:label "Raw air" ; dct:description "Input observations." ; dct:type "dataset" .
<https://fixtures.example.test/datasets/air-quality> a dcat:Dataset ;
  rdfs:label "Air quality" ; dct:description "Published observations." ; dct:type "dataset" ;
  dcat:distribution <https://fixtures.example.test/distributions/air-quality> ;
  dprod:informationSensitivityClassification <https://fixtures.example.test/classifications/public> .
<https://fixtures.example.test/classifications/public> a dprod:InformationSensitivityClassification .
<https://fixtures.example.test/distributions/air-quality> a dcat:Distribution ;
  dcat:accessService <https://fixtures.example.test/services/output> ;
  dprod:isDistributionOf <https://fixtures.example.test/datasets/air-quality> ;
  dct:conformsTo <https://fixtures.example.test/contracts/air-quality> ; dct:format "CSV" .
<https://fixtures.example.test/services/input> a dcat:DataService ;
  dprod:isAccessServiceOf <https://fixtures.example.test/distributions/air-quality> ;
  dprod:protocol <https://fixtures.example.test/protocols/https> ;
  dprod:securitySchemaType <https://fixtures.example.test/security/oauth> ;
  dcat:endpointURL <https://api.fixtures.example.test/input> .
<https://fixtures.example.test/services/output> a dcat:DataService ;
  dprod:isAccessServiceOf <https://fixtures.example.test/distributions/air-quality> ;
  dprod:protocol <https://fixtures.example.test/protocols/https> ;
  dprod:securitySchemaType <https://fixtures.example.test/security/oauth> ;
  dcat:endpointURL <https://api.fixtures.example.test/air-quality> .
<https://fixtures.example.test/security/oauth> a dprod:SecuritySchemaType .
