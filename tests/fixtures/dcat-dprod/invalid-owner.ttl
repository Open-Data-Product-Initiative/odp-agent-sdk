@prefix dprod: <https://www.omg.org/spec/DPROD/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://fixtures.example.test/products/air-quality> a dprod:DataProduct ;
  rdfs:label "Invalid air-quality product" ;
  dct:description "This product intentionally has an invalid owner." ;
  dprod:purpose "Exercise the DPROD invalid-source path." ;
  dprod:dataProductOwner "not-an-agent" ;
  dprod:domain <https://fixtures.example.test/domains/environment> ;
  dprod:lifecycleStatus <https://fixtures.example.test/lifecycle/deploy> .

<https://fixtures.example.test/lifecycle/deploy> a dprod:DataProductLifecycleStatus .
